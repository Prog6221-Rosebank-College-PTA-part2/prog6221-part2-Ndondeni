<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">

    <Grid Background="#F5F5F5">
      
        <!-- Main Chat Container -->
        <Border Background="#FF1CDE8D"
                Padding="10"
                Margin="64,40,56,16"
                CornerRadius="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="*"/>
                    <!-- Chat Messages -->
                    <RowDefinition Height="Auto"/>
                    <!-- Input Area -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock x:Name="header"
                           Text="Chat"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <Image HorizontalAlignment="Left" Height="49" VerticalAlignment="Top" Width="71" Source="/Assets/Screenshot 2026-05-25 080945.png"/>
                <!-- Chat Messages Area -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="12"
                        Margin="0,0,0,10"
                        Padding="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="chatPanel"/>
                    </ScrollViewer>
                </Border>

                <!-- Input Area -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Text Input -->
                    <TextBox x:Name="input"
                             Grid.Column="0"
                             Height="32"
                             VerticalAlignment="Center"
                             Padding="10,5"
                            
                             Text="Type your message here"
                             Foreground="Gray"
                             Background="White"
                             BorderBrush="#CCCCCC"
                             BorderThickness="1"/>

                    <!-- Send Button -->
                    <Button x:Name="Button1"
                            Grid.Column="2"
                            Height="32"
                            Width="80"
                            Content="Send"
                            Click="SendText"
                            Background="#FF1A1A1A"
                            Foreground="White"
                            BorderThickness="0"/>
                </Grid>
            </Grid>
        </Border>
        
    </Grid>
</Window>